# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/aion?schema=public"

# --- Auth ---
# Random 32+ char secret used to sign the demo session cookie (HMAC-SHA256).
# If unset, falls back to an insecure hardcoded value with a console warning
# — fine for a quick local try, never for anything real. This signs AION's
# single demo-user session; it is not a substitute for real authentication.
SESSION_SECRET="replace-with-a-long-random-string"

# --- AI provider (provider-agnostic layer, see src/lib/ai/client.ts) ---
AI_PROVIDER="gemini"             # anthropic | openai | gemini
AI_API_KEY=""                    # never hardcode this — set it in your host's secret manager
# Get a free Gemini key at https://aistudio.google.com/apikey (Flash-class
# models are the free-tier-eligible ones; Pro models generally aren't).
AI_MODEL="gemini-2.5-flash"

# --- Optional targeted web-search fallback (only used when the DB has no answer) ---
# Provider-abstracted (see src/lib/search/fallback.ts) — currently "brave" or "none".
# Only ever called for a specific, narrow query (a topic or a search term), never a broad crawl.
SEARCH_PROVIDER="none"
SEARCH_API_KEY=""

# --- Source connectors (all optional; missing keys just disable that source) ---
GITHUB_TOKEN=""                  # raises GitHub API rate limits for open-source ingestion
# NOTE: Semantic Scholar is NOT currently an active connector (schema has a
# SEMANTIC_SCHOLAR SourceKind reserved for it, but lib/sources has no
# implementation yet) — nothing to configure here until that's built.

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Same value as VAPID_PUBLIC_KEY above — exposed to the browser to subscribe (public keys are safe to expose).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Cron protection ---
# Shared secret your deployment platform's scheduler sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET="replace-with-a-long-random-string"

# Gates operator-level endpoints that affect ALL users or expose internal
# operational detail: /api/settings/sources (global source toggling, via
# `Authorization: Bearer`) and /status (source health — sign in with this
# secret at the page's login form; it sets an httpOnly session cookie, never
# a URL param). Unset = denied by default, not open. Dev/admin-only, not a
# general auth system.
ADMIN_SECRET="replace-with-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Free-tier controls (all optional; defaults below assume Gemini free tier) ---
# AI_RPM=5                    # max requests/minute (0 = unlimited; set 0 on a paid plan)
# AI_RPD=20                   # max requests/day per model (0 = unlimited)
# AI_INGEST_DAILY_CAP=10      # how many of those daily calls ingestion may use; rest kept for Radar/brief/Ask
# AI_INGEST_LLM_PER_RUN=6     # LLM calls per `npm run ingest:*` category run; everything else uses heuristics
# INGEST_MAX_ITEMS_PER_SOURCE=100
# AI_FALLBACK_MODELS=         # comma-separated extra models to use once the primary's daily quota is gone
